---
// === 1. IMPORTS ===
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadAllPlants } from '@/lib/loadPlants';
import { countPlantsPerForm } from '@/lib/preparationPlants';
import { ZUBEREITUNG_EN, ZUBEREITUNG_SLUG_EN, ZUBEREITUNG_REIHENFOLGE } from '@/lib/preparationText';

// === 2. DATEN ===
const plants = loadAllPlants();
const zaehler = countPlantsPerForm(plants);
const formen = ZUBEREITUNG_REIHENFOLGE.filter(f => (zaehler[f] ?? 0) > 0);

const title = 'Preparing medicinal plants';
const description =
  'Tea, tincture, compress, salve and six further ways of preparing a plant — each ' +
  'with working steps, quantities, limits and the matching plants from the database.';
---

<BaseLayout locale="en" title={title} description={description} altPath="/de/zubereitung/">
  <section class="max-w-6xl mx-auto px-4 pt-8 pb-12">
    <h1 class="font-serif text-3xl md:text-4xl text-slate-900 mb-4">
      Preparing medicinal plants
    </h1>

    <div class="max-w-2xl space-y-3 text-slate-600 mb-8">
      <p class="text-lg leading-relaxed text-pretty">
        Every use listed on a plant page in this database names the form it has been
        handed down in — as a tea, as a tincture, as a compress. What does not fit on
        that page is the question of how you actually do it. These pages fill that gap.
      </p>
      <p class="text-pretty">
        The preparation decides whether anything ends up in the cup at all. Water
        dissolves different substances than alcohol, and alcohol different ones than
        fat; a mucilage-rich root loses its mucilage if you boil it, and an essential
        oil leaves as steam if the cup stands open. Each of the following pages explains
        the method, gives the quantities used in the specialist literature, and says
        where self-treatment ends.
      </p>
      <p class="text-sm text-slate-500 text-pretty">
        The plant lists contain no toxic and no legally controlled species — they have
        no place on a page that shows people how to do something. They remain reachable
        through the search and the plant index.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {formen.map(form => { const z = ZUBEREITUNG_EN[form]; return (
        <a href={`/en/preparation/${ZUBEREITUNG_SLUG_EN[form]}/`}
          class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-5 hover:border-emerald-600 hover:shadow-md transition">
          <span class="font-serif text-xl text-slate-900 group-hover:text-emerald-800">{z.titel}</span>
          <p class="mt-2 flex-1 text-sm leading-snug text-slate-600">{z.kurz}</p>
          <span class="mt-3 text-xs font-medium text-emerald-700">
            {zaehler[form]} {zaehler[form] === 1 ? 'plant' : 'plants'} in this form
          </span>
        </a>
      ); })}
    </div>

    <p class="mt-10 text-sm text-slate-500">
      <a href="/en/" class="text-emerald-700 hover:underline">All plants</a> ·
      <a href="/en/help-with" class="text-emerald-700 hover:underline">Help with symptoms</a> ·
      <a href="/en/calendar" class="text-emerald-700 hover:underline">Harvest calendar</a>
    </p>
  </section>
</BaseLayout>
