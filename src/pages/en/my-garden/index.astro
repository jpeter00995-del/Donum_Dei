---
// === 1. IMPORTS ===
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlanView from '@/components/PlanView.tsx';
import { loadAllPlants } from '@/lib/loadPlants';
import { toPlanPlant } from '@/lib/planPlant';
import { SEITEN_TEXT } from '@/lib/seitenText';
import '@/styles/print.css';

// === 2. DATA ===
// Schlankes Plan-DTO statt voller Plant-Objekte → kleine client:load-Props.
const locale = 'en' as const;
const plants = loadAllPlants().map(toPlanPlant);
---

<BaseLayout locale={locale} title="My Garden — a planting plan for your space" description="A planting plan for a balcony, raised bed or open ground: selection by climate zone and space, sowing and harvest calendar, companion planting notes. No account, everything stays in your browser." altPath="/de/mein-garten/">
  <section class="max-w-6xl mx-auto py-8 px-4 print-area">
    {/* Server-rendered text — this page was previously empty for crawlers. */}
    <header class="max-w-3xl mb-8 print:hidden">
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-slate-900 mb-4">
        My Garden — a planting plan for your space
      </h1>
      {SEITEN_TEXT.meinGarten.en.map(absatz => (
        <p class="mt-3 text-slate-700 leading-relaxed text-pretty">{absatz}</p>
      ))}
    </header>
    <PlanView plants={plants} locale={locale} client:load />
  </section>
</BaseLayout>
