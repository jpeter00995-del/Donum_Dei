---
// === 1. IMPORTS ===
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getAllSymptoms, findPlantsForSymptom, getSymptomDisclaimer } from '@/lib/symptomSearch';
import { loadAllPlants } from '@/lib/loadPlants';
import { SYMPTOM_TEXT_EN } from '@/lib/symptomText';

// === 2. STATIC PATHS — one page per symptom ===
export function getStaticPaths() {
  return getAllSymptoms().map(s => ({ params: { symptom: s.id }, props: { symptom: s } }));
}

const { symptom } = Astro.props;
const locale = 'en' as const;
const plants = loadAllPlants();
const matches = findPlantsForSymptom(symptom.id, plants, 40);
const name = symptom.name_en;

// Card reason: prefer the text of the use that triggered the match, falling
// back to the first sentence of the description.
function shorten(text: string): string {
  const first = text.split(/(?<=[.!])\s/)[0] ?? '';
  return first.length > 150 ? first.slice(0, 147).trimEnd() + '…' : first;
}
function reasonText(m: typeof matches[number]): string {
  return shorten(m.reason?.[locale] || m.plant.description?.[locale] || '');
}
const intro = SYMPTOM_TEXT_EN[symptom.id] ?? '';

const title = `Medicinal Plants for ${name}`;
const description =
  `Which medicinal plants are used for ${name}? ${matches.length} plants from our ` +
  `database with traditional use – each with a profile, safety notes and sources.`;
---

<BaseLayout locale={locale} title={title} description={description} altPath={`/de/heilpflanzen-gegen/${symptom.id}/`}>
  <section class="max-w-6xl mx-auto px-4 pt-8 pb-12">
    <Breadcrumbs locale={locale} class="mb-4" items={[
      { label: 'Plants', href: '/en/' },
      { label: 'Help with symptoms', href: '/en/help-with' },
      { label: name },
    ]} />
    <h1 class="font-serif text-3xl md:text-4xl text-slate-900 mb-4">
      {symptom.emoji} Medicinal Plants for {name}
    </h1>
    <p class="max-w-2xl text-lg leading-relaxed text-slate-600 mb-3 text-pretty">
      {intro}
    </p>
    <p class="max-w-2xl text-slate-600 mb-2 text-pretty">
      {matches.length} plants from our database are traditionally associated with {name} – each
      with a profile, active compounds, safety notes and sources. Poisonous and legally
      controlled species are deliberately left out of this list; they remain reachable through
      the search and the plant index.
    </p>
    <p class="text-sm text-slate-400 mb-8">{getSymptomDisclaimer(locale)}</p>

    {matches.length === 0 ? (
      <p class="text-slate-500">No plants are currently listed for this topic.</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {matches.map(m => { const p = m.plant; return (
          <a href={`/en/plant/${p.slug}/`}
            class="group flex gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-3 hover:border-emerald-600 transition">
            <img src={`/images/plants/${p.image.filename}`} alt={p.image.alt?.en ?? p.names.en}
              width="72" height="72" loading="lazy"
              class="flex-none rounded-xl object-cover bg-slate-100" style="width:72px;height:72px;" />
            <div class="min-w-0">
              <span class="font-serif text-slate-900 leading-tight">{p.names.en}</span>
              <div class="text-xs italic text-slate-400">{p.names.latin}</div>
              <p class="mt-1 text-[13px] leading-snug text-slate-600 line-clamp-3">{reasonText(m)}</p>
            </div>
          </a>
        ); })}
      </div>
    )}

    <p class="mt-10 text-sm text-slate-500">
      Different concern? <a href="/en/help-with" class="text-emerald-700 hover:underline">All complaints at a glance</a> ·
      <a href="/en/" class="text-emerald-700 hover:underline">all plants</a>
    </p>
  </section>
</BaseLayout>
