---
// === 1. IMPORTS ===
import BaseLayout from '@/layouts/BaseLayout.astro';
import SymptomFinder from '@/components/SymptomFinder.tsx';
import { loadAllPlants } from '@/lib/loadPlants';
import { toSymptomPlant } from '@/lib/symptomCard';
import { getAllSymptoms } from '@/lib/symptomSearch';
import { t } from '@/lib/i18n';
import { SEITEN_TEXT } from '@/lib/seitenText';

// === 2. DATA ===
// Build-Zeit-Projektion auf schlanke DTO — spart ~90% Prop-Groesse im HTML.
const locale = 'en' as const;
const plants = loadAllPlants().map(toSymptomPlant);
const symptoms = getAllSymptoms();
---

<BaseLayout locale={locale} title={t(locale, 'symptoms.page_title')}>
  <article class="max-w-5xl mx-auto py-8 px-4">
    <!-- === 1. HERO === -->
    <header class="mb-8">
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-slate-900">
        {t(locale, 'symptoms.page_title')}
      </h1>
      <p class="mt-3 text-base text-slate-700 leading-relaxed">
        {t(locale, 'symptoms.page_intro')}
      </p>
      {/* Serverseitiger Text — die Seite war fuer Crawler zu duenn. */}
      <div class="max-w-3xl">
        {SEITEN_TEXT.hilfeBei.en.map(absatz => (
          <p class="mt-3 text-slate-700 leading-relaxed text-pretty">{absatz}</p>
        ))}
      </div>
    </header>

    <!-- === 2. INTERACTIVE SEARCH === -->
    <SymptomFinder client:load plants={plants} locale={locale} />

    <!-- === 3. TOPIC PAGES (Medicinal plants for …) === -->
    <section class="mt-12">
      <h2 class="font-serif text-2xl text-slate-900 mb-4">Medicinal plants for …</h2>
      <div class="flex flex-wrap gap-2.5">
        {symptoms.map(s => (
          <a href={`/en/plants-for/${s.id}/`}
            class="rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 hover:border-emerald-600 hover:text-emerald-700 transition">
            {s.emoji} {s.name_en}
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
