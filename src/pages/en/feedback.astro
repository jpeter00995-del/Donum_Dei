---
// === 1. IMPORTS ===
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeedbackForm from '@/components/FeedbackForm.tsx';
import { t } from '@/lib/i18n';

// === 2. KONSTANTEN ===
const locale = 'en' as const;
---

<BaseLayout locale={locale} title="Feedback">
  <div class="max-w-2xl mx-auto px-4 py-8">
    <!-- === 1. HERO === -->
    <header class="mb-6">
      <h1 class="text-3xl font-serif font-bold text-slate-900 mb-3">
        {t(locale, 'feedback.hero_title')}
      </h1>
      <p class="text-slate-600">{t(locale, 'feedback.intro')}</p>
      {/* Serverseitiger Text — die Seite war fuer Crawler zu duenn (2026-08-10). */}
      <p class="mt-3 text-slate-700 leading-relaxed text-pretty">This database is maintained by a single person, and 297 plant entries inevitably contain mistakes. If you spot one — a wrong figure, an unclear sentence, a photograph that does not match the species — a short message is the most valuable thing you can contribute.</p>
      <p class="mt-3 text-slate-700 leading-relaxed text-pretty">Pointers with a source are especially helpful. Every statement on the plant pages carries a reference, so a correction can only be worked in once it is clear what it rests on. A line such as "the Commission E monograph says otherwise" achieves more than any long discussion.</p>
      <p class="mt-3 text-slate-700 leading-relaxed text-pretty">What cannot be answered here: anything medical. Health complaints belong with a doctor or pharmacist, not in a contact form. If you suspect poisoning, call your poison control centre or emergency services immediately.</p>
    </header>

    <!-- === 2. FORM === -->
    <section class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
      <FeedbackForm client:load locale={locale} />
    </section>

    <!-- === 3. FALLBACK MAILTO === -->
    <p class="mt-6 text-center text-sm text-slate-500">
      {t(locale, 'feedback.fallback_mailto')}{' '}
      <a
        href="mailto:maikelganske913@gmail.com?subject=Donum%20Dei%20Feedback"
        class="text-emerald-700 hover:text-emerald-800 underline"
      >
        {t(locale, 'feedback.fallback_mailto_link')}
      </a>
    </p>
  </div>
</BaseLayout>
