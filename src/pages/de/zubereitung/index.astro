---
// === 1. IMPORTS ===
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { loadAllPlants } from '@/lib/loadPlants';
import { countPlantsPerForm } from '@/lib/preparationPlants';
import { ZUBEREITUNG_DE, ZUBEREITUNG_SLUG_DE, ZUBEREITUNG_REIHENFOLGE } from '@/lib/preparationText';

// === 2. DATEN ===
const plants = loadAllPlants();
const zaehler = countPlantsPerForm(plants);
const formen = ZUBEREITUNG_REIHENFOLGE.filter(f => (zaehler[f] ?? 0) > 0);

const title = 'Zubereitung von Heilpflanzen';
const description =
  'Tee, Tinktur, Umschlag, Salbe und sechs weitere Zubereitungsarten — jeweils mit ' +
  'Arbeitsschritten, Mengenangaben, Grenzen und den passenden Pflanzen aus der Datenbank.';
---

<BaseLayout locale="de" title={title} description={description} altPath="/en/preparation/">
  <section class="max-w-6xl mx-auto px-4 pt-8 pb-12">
    <Breadcrumbs locale="de" class="mb-4" items={[
      { label: 'Pflanzen', href: '/de/' },
      { label: 'Zubereitung' },
    ]} />
    <h1 class="font-serif text-3xl md:text-4xl text-slate-900 mb-4">
      Zubereitung von Heilpflanzen
    </h1>

    <div class="max-w-2xl space-y-3 text-slate-600 mb-8">
      <p class="text-lg leading-relaxed text-pretty">
        Auf den Pflanzenseiten dieser Datenbank steht bei jeder Anwendung, in welcher
        Form sie überliefert ist — als Tee, als Tinktur, als Umschlag. Was dort nicht
        hineinpasst, ist die Frage, wie man das eigentlich macht. Diese Seiten holen
        das nach.
      </p>
      <p class="text-pretty">
        Die Zubereitung entscheidet mit darüber, ob überhaupt etwas in der Tasse landet.
        Wasser löst andere Stoffe als Alkohol, Alkohol andere als Fett; eine
        schleimhaltige Wurzel verliert ihren Schleim, wenn man sie kocht, und ein
        ätherisches Öl zieht als Dampf davon, wenn die Tasse offen steht. Jede der
        folgenden Seiten erklärt die Methode, nennt die Mengen aus der Fachliteratur
        und sagt, wo die Selbstanwendung aufhört.
      </p>
      <p class="text-sm text-slate-500 text-pretty">
        Die Pflanzenlisten enthalten keine giftigen und keine rechtlich kontrollierten
        Arten, und bei Pflanzen mit Vorsichtshinweis keine innerlichen Anwendungen, für
        die es nur eine volkstümliche Überlieferung gibt — auf einer Anleitungsseite
        haben sie nichts verloren. Über Suche und Register bleiben sie erreichbar.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {formen.map(form => { const z = ZUBEREITUNG_DE[form]; return (
        <a href={`/de/zubereitung/${ZUBEREITUNG_SLUG_DE[form]}/`}
          class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-5 hover:border-emerald-600 hover:shadow-md transition">
          <span class="font-serif text-xl text-slate-900 group-hover:text-emerald-800">{z.titel}</span>
          <p class="mt-2 flex-1 text-sm leading-snug text-slate-600">{z.kurz}</p>
          <span class="mt-3 text-xs font-medium text-emerald-700">
            {zaehler[form]} {zaehler[form] === 1 ? 'Pflanze' : 'Pflanzen'} in dieser Form
          </span>
        </a>
      ); })}
    </div>

    <p class="mt-10 text-sm text-slate-500">
      <a href="/de/" class="text-emerald-700 hover:underline">Alle Pflanzen</a> ·
      <a href="/de/hilfe-bei" class="text-emerald-700 hover:underline">Hilfe bei Beschwerden</a> ·
      <a href="/de/kalender" class="text-emerald-700 hover:underline">Ernte-Kalender</a>
    </p>
  </section>
</BaseLayout>
