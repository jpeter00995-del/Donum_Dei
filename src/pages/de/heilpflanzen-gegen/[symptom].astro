---
// === 1. IMPORTS ===
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllSymptoms, findPlantsForSymptom, getSymptomDisclaimer } from '@/lib/symptomSearch';
import { loadAllPlants } from '@/lib/loadPlants';

// === 2. STATIC PATHS — eine Seite je Symptom ===
export function getStaticPaths() {
  return getAllSymptoms().map(s => ({ params: { symptom: s.id }, props: { symptom: s } }));
}

const { symptom } = Astro.props;
const locale = 'de' as const;
const plants = loadAllPlants();
const matches = findPlantsForSymptom(symptom.id, plants, 40);
const name = symptom.name_de;

// Kurzer Grund = erster Satz der eigenen Beschreibung.
function blurb(p: typeof plants[number]): string {
  const d = p.description?.[locale] ?? '';
  const first = d.split(/(?<=[.!])\s/)[0] ?? '';
  return first.length > 150 ? first.slice(0, 147).trimEnd() + '…' : first;
}

const title = `Heilpflanzen gegen ${name}`;
const description =
  `Welche Heilpflanzen helfen bei ${name}? ${matches.length} Pflanzen aus unserer ` +
  `Datenbank mit traditioneller Anwendung – jeweils mit Steckbrief, Sicherheit und Quellen.`;
---

<BaseLayout locale={locale} title={title} description={description}>
  <section class="max-w-6xl mx-auto px-4 pt-8 pb-12">
    <h1 class="font-serif text-3xl md:text-4xl text-slate-900 mb-4">
      {symptom.emoji} Heilpflanzen gegen {name}
    </h1>
    <p class="max-w-2xl text-lg leading-relaxed text-slate-600 mb-2 text-pretty">
      Bei {name} werden in der überlieferten Pflanzenheilkunde verschiedene Heilpflanzen
      eingesetzt. Diese {matches.length} Pflanzen aus unserer Datenbank sind traditionell
      mit {name} verknüpft – jeweils mit Steckbrief, Wirkstoffen, Sicherheitshinweisen und
      Quellen. Tippe auf eine Pflanze für Details.
    </p>
    <p class="text-sm text-slate-400 mb-8">{getSymptomDisclaimer(locale)}</p>

    {matches.length === 0 ? (
      <p class="text-slate-500">Zu diesem Thema sind derzeit keine Pflanzen hinterlegt.</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {matches.map(({ plant: p }) => (
          <a href={`/de/plant/${p.slug}/`}
            class="group flex gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-3 hover:border-emerald-600 transition">
            <img src={`/images/plants/${p.image.filename}`} alt={p.image.alt?.de ?? p.names.de}
              width="72" height="72" loading="lazy"
              class="flex-none rounded-xl object-cover bg-slate-100" style="width:72px;height:72px;" />
            <div class="min-w-0">
              <span class="font-serif text-slate-900 leading-tight">{p.names.de}</span>
              <div class="text-xs italic text-slate-400">{p.names.latin}</div>
              <p class="mt-1 text-[13px] leading-snug text-slate-600 line-clamp-3">{blurb(p)}</p>
            </div>
          </a>
        ))}
      </div>
    )}

    <p class="mt-10 text-sm text-slate-500">
      Anderes Anliegen? <a href="/de/hilfe-bei" class="text-emerald-700 hover:underline">Alle Beschwerden im Überblick</a> ·
      <a href="/de/" class="text-emerald-700 hover:underline">alle Pflanzen</a>
    </p>
  </section>
</BaseLayout>
