---
// === 1. IMPORTS ===
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FeedbackForm from '@/components/FeedbackForm.tsx';
import { t } from '@/lib/i18n';

// === 2. KONSTANTEN ===
const locale = 'de' as const;
---

<BaseLayout locale={locale} title="Feedback">
  <div class="max-w-2xl mx-auto px-4 py-8">
    <!-- === 1. HERO === -->
    <header class="mb-6">
      <Breadcrumbs locale="de" class="mb-4" items={[
        { label: 'Pflanzen', href: '/de/' },
        { label: 'Feedback' },
      ]} />
      <h1 class="text-3xl font-serif font-bold text-slate-900 mb-3">
        {t(locale, 'feedback.hero_title')}
      </h1>
      <p class="text-slate-600">{t(locale, 'feedback.intro')}</p>
      {/* Serverseitiger Text — die Seite war fuer Crawler zu duenn (2026-08-10). */}
      <p class="mt-3 text-slate-700 leading-relaxed text-pretty">Diese Datenbank wird von einer einzelnen Person gepflegt, und in 297 Pflanzeneinträgen stecken zwangsläufig Fehler. Wenn dir einer auffällt — eine falsche Angabe, eine unklare Formulierung, ein Bild, das nicht zur Art passt — ist eine kurze Nachricht das Wertvollste, was du beitragen kannst.</p>
      <p class="mt-3 text-slate-700 leading-relaxed text-pretty">Besonders hilfreich sind Hinweise mit Quelle. Jede Aussage auf den Pflanzenseiten ist mit einem Beleg hinterlegt; eine Korrektur lässt sich deshalb nur einarbeiten, wenn klar ist, worauf sie sich stützt. Ein Satz wie „laut Kommission-E-Monographie steht dort etwas anderes" bringt mehr als jede lange Diskussion.</p>
      <p class="mt-3 text-slate-700 leading-relaxed text-pretty">Was hier nicht beantwortet werden kann: alles Medizinische. Bei gesundheitlichen Beschwerden gehört die Frage zu Arzt oder Apotheker, nicht in ein Kontaktformular. Bei einem Verdacht auf Vergiftung ruf sofort den Giftnotruf oder den Rettungsdienst.</p>
    </header>

    <!-- === 2. FORM === -->
    <section class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
      <FeedbackForm client:load locale={locale} />
    </section>

    <!-- === 3. FALLBACK MAILTO === -->
    <p class="mt-6 text-center text-sm text-slate-500">
      {t(locale, 'feedback.fallback_mailto')}{' '}
      <a
        href="mailto:maikelganske913@gmail.com?subject=Donum%20Dei%20Feedback"
        class="text-emerald-700 hover:text-emerald-800 underline"
      >
        {t(locale, 'feedback.fallback_mailto_link')}
      </a>
    </p>
  </div>
</BaseLayout>
