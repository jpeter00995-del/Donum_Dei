---
// === 1. IMPORTS ===
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PlanView from '@/components/PlanView.tsx';
import { loadAllPlants } from '@/lib/loadPlants';
import { toPlanPlant } from '@/lib/planPlant';
import { SEITEN_TEXT } from '@/lib/seitenText';
import '@/styles/print.css';

// === 2. DATA ===
// Schlankes Plan-DTO statt voller Plant-Objekte → kleine client:load-Props.
const locale = 'de' as const;
const plants = loadAllPlants().map(toPlanPlant);
---

<BaseLayout locale={locale} title="Mein Garten — Pflanzplan für deine Fläche" description="Pflanzplan für Balkon, Hochbeet oder Freiland: Auswahl nach Klimazone und Platz, Aussaat- und Erntekalender, Mischkultur-Hinweise. Ohne Konto, alles bleibt im Browser.">
  <section class="max-w-6xl mx-auto py-8 px-4 print-area">
    {/* Serverseitiger Text — die Seite war vorher fuer Crawler komplett leer. */}
    <header class="max-w-3xl mb-8 print:hidden">
      <Breadcrumbs locale="de" class="mb-4" items={[
        { label: 'Pflanzen', href: '/de/' },
        { label: 'Mein Garten' },
      ]} />
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-slate-900 mb-4">
        Mein Garten — Pflanzplan für deine Fläche
      </h1>
      {SEITEN_TEXT.meinGarten.de.map(absatz => (
        <p class="mt-3 text-slate-700 leading-relaxed text-pretty">{absatz}</p>
      ))}
    </header>
    <PlanView plants={plants} locale={locale} client:load />
  </section>
</BaseLayout>
