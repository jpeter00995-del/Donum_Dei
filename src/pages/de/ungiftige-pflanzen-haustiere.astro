---
// === 1. IMPORTS ===
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadAllPlants } from '@/lib/loadPlants';
import { splitPetSafe, getPetCheck } from '@/lib/petSafety';

// === 2. DATA ===
// Zwei Gruppen statt einer Liste: Was die ASPCA ausdrücklich als ungiftig
// führt, und was wir selbst so eingestuft haben, ohne externen Beleg.
// Ein "ungiftig" ohne Quelle ist ein Sicherheitsversprechen, das wir nicht
// halten können — deshalb steht es getrennt und benannt.
const locale = 'de' as const;
const all = loadAllPlants();
const { checked, unchecked } = splitPetSafe(all, locale);
const indoorChecked = checked.filter(p => p.indoor_growing?.suitable === true);

const title = 'Ungiftige Pflanzen für Katzen & Hunde';
const description =
  `Welche Pflanzen sind ungiftig für Katzen und Hunde? ${checked.length} Pflanzen mit ` +
  `ASPCA-Beleg und ${unchecked.length} weitere ohne externe Prüfung, klar getrennt.`;
---

<BaseLayout locale={locale} title={title} description={description} altPath="/en/pet-safe-plants/">
  <section class="max-w-6xl mx-auto px-4 pt-8 pb-12">
    <h1 class="font-serif text-3xl md:text-4xl text-slate-900 mb-4">Ungiftige Pflanzen für Katzen &amp; Hunde</h1>
    <p class="max-w-2xl text-lg leading-relaxed text-slate-600 mb-2 text-pretty">
      Du suchst Pflanzen, die für deine Haustiere unbedenklich sind? {checked.length}
      Pflanzen aus unserer Datenbank führt die ASPCA (der Giftnotruf für Tiere in den USA)
      ausdrücklich als ungiftig für Hunde und Katzen. Sie stehen zuerst.
      {indoorChecked.length} davon eignen sich als Zimmerpflanze.
    </p>
    <p class="max-w-2xl text-slate-600 mb-2">
      Danach folgen {unchecked.length} Pflanzen, die wir selbst als unbedenklich einschätzen,
      für die es aber keinen Eintrag in einer Giftliste gibt. Diese Trennung ist Absicht:
      Wir sagen lieber, was wir nicht wissen.
    </p>
    <p class="text-sm text-slate-400 mb-8">
      Auch bei ungiftigen Pflanzen kann das Anknabbern in größeren Mengen zu Magen-Darm-Reizungen
      führen. Im Zweifel tierärztlichen Rat einholen.
    </p>

    {indoorChecked.length > 0 && (
      <>
        <h2 class="font-serif text-2xl text-slate-900 mb-3">Geprüft und als Zimmerpflanze geeignet</h2>
        <div class="flex flex-wrap gap-2.5 mb-10">
          {indoorChecked.map(p => (
            <a href={`/de/plant/${p.slug}/`}
              class="rounded-full border border-emerald-100 bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700 hover:border-emerald-600 transition">
              {p.names.de}
            </a>
          ))}
        </div>
      </>
    )}

    <h2 class="font-serif text-2xl text-slate-900 mb-1">Von der ASPCA als ungiftig geführt</h2>
    <p class="text-sm text-slate-500 mb-4">
      {checked.length} Pflanzen. Die Quelle steht auf jeder Pflanzenseite unter „Quellen".
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {checked.map(p => (
        <a href={`/de/plant/${p.slug}/`}
          class="group flex gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-3 hover:border-emerald-600 transition">
          <img src={`/images/plants/${p.image.filename}`} alt={p.image.alt?.de ?? p.names.de}
            width="72" height="72" loading="lazy"
            class="flex-none rounded-xl object-cover bg-slate-100" style="width:72px;height:72px;" />
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-serif text-slate-900 leading-tight">{p.names.de}</span>
              <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700">
                ungiftig · ASPCA
              </span>
              {getPetCheck(p)?.match === 'genus' && (
                <span class="text-[11px] text-slate-400">(Gattung)</span>
              )}
            </div>
            <div class="text-xs italic text-slate-400">{p.names.latin}</div>
          </div>
        </a>
      ))}
    </div>

    <h2 class="font-serif text-2xl text-slate-900 mt-12 mb-1">Ohne externe Prüfung</h2>
    <p class="max-w-2xl text-sm text-slate-500 mb-4">
      {unchecked.length} Pflanzen. Uns sind keine Hinweise auf eine Gefahr für Hund oder Katze
      bekannt, und die ASPCA führt sie nicht — weder als giftig noch als ungiftig. Das ist
      kein Freibrief: Wer ein Tier hat, das an Pflanzen knabbert, fragt hier besser
      die Tierärztin.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {unchecked.map(p => (
        <a href={`/de/plant/${p.slug}/`}
          class="group flex gap-3 rounded-2xl border border-slate-200 bg-white p-3 hover:border-slate-400 transition">
          <img src={`/images/plants/${p.image.filename}`} alt={p.image.alt?.de ?? p.names.de}
            width="72" height="72" loading="lazy"
            class="flex-none rounded-xl object-cover bg-slate-100" style="width:72px;height:72px;" />
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-serif text-slate-900 leading-tight">{p.names.de}</span>
              <span class="rounded-full border border-slate-200 bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-500">
                nicht extern geprüft
              </span>
            </div>
            <div class="text-xs italic text-slate-400">{p.names.latin}</div>
          </div>
        </a>
      ))}
    </div>

    <p class="mt-10 text-sm text-slate-500">
      Verwandt: <a href="/de/giftige-pflanzen-katzen-hunde" class="text-emerald-700 hover:underline">Giftige Pflanzen für Katzen &amp; Hunde</a> ·
      <a href="/de/zuhause-anbauen" class="text-emerald-700 hover:underline">Zimmerpflanzen</a>
    </p>
  </section>
</BaseLayout>
